[Unit]
Description=Carrier credentials maintenance (erase expired retired secrets, apply validity windows)
After=network-online.target postgresql.service freeswitch.service
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/fusionpbx
ExecStart=/usr/bin/php /var/www/fusionpbx/app/x_carrier_credentials/resources/cli/x_carriers_keyring.php maintenance
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
UMask=0027
